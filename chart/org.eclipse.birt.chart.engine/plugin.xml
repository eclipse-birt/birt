<plugin>

     <!-- Engine Framework Extension Points -->
   <!-- 
   		Model Renderer Extension Point. 
   		Use this to register a custom Model Renderer.
   		To see how this extension point can be used, take a look at the extensions defined in org.eclipse.birt.chart.engine.extension plug-in.
   -->
   <extension-point id="modelrenderers" name="%extension-point.name" schema="schema/modelrenderers.exsd"/>
   <!--
   		DataSet Processor Extension Point.
   		Use this extension point to register data set processors for series that use custom data elements.
   		To see how this extension point can be used, take a look at the extensions defined in org.eclipse.birt.chart.engine.extension plug-in.
   -->
   <extension-point id="datasetprocessors" name="%extension-point.name.0" schema="schema/datasetprocessors.exsd"/>
   
   <!-- Device related Extension Points -->
   <!-- 
   		XServer Extension Point.
   		Use this extension point to register a custom Display Server.
   		To see how this extension point can be used, take a look at the extensions defined in org.eclipse.birt.chart.device.extension plug-in.
   -->
   <extension-point id="displayservers" name="%extension-point.name.1" schema="schema/displayservers.exsd"/>
   <!-- 
   		Device Renderer Extension Point.
   		Use this extension point to register a custom Device Renderer.
   		To see how this extension point can be used, take a look at the extensions defined in org.eclipse.birt.chart.device.extension plug-in.
   -->
   <extension-point id="devicerenderers" name="%extension-point.name.2" schema="schema/devicerenderers.exsd"/>
   <extension-point id="aggregatefunctions" name="%extension-point.name.3" schema="schema/aggregatefunctions.exsd"/>
   <extension-point id="datapointdefinitions" name="%extension-point.name.4" schema="schema/datapointdefinitions.exsd"/>
   <extension-point id="charttypes" name="%extension-point.name.5" schema="schema/charttypes.exsd"/>

   <extension point="org.eclipse.emf.ecore.generated_package">
