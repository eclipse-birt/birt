<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.eclipse.birt.build.package</groupId>
		<artifactId>org.eclipse.birt.build.package-parent</artifactId>
		<version>4.26.0-SNAPSHOT</version>
		<relativePath>../</relativePath>
	</parent>
	<groupId>org.eclipse.birt</groupId>
	<artifactId>birt-report-all-in-one</artifactId>
	<packaging>eclipse-repository</packaging>

	<profiles>
		<profile>
			<id>build-server</id>
			<build>
				<plugins>

					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>${antrun.version}</version>
						<executions>
							<execution>
								<id>unpack-executables</id>
								<phase>generate-resources</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<delete dir="${project.build.directory}/executables-to-sign"/>
										<unzip src="${project.build.directory}/extraArtifacts/org.eclipse.birt.report.designer.all.executable.win32.win32.x86_64.zip" dest="${project.build.directory}/executables-to-sign/x86_64"/>
										<unzip src="${project.build.directory}/extraArtifacts/org.eclipse.birt.report.designer.all.executable.win32.win32.aarch64.zip" dest="${project.build.directory}/executables-to-sign/aarch64"/>
									</target>
								</configuration>
							</execution>
							<execution>
								<id>repack-signed-executables</id>
								<phase>process-resources</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<!-- Recreate the archives: ZIP timestamps have only two-second precision,
										     so updating in place can miss freshly signed executables. -->
										<delete file="${project.build.directory}/extraArtifacts/org.eclipse.birt.report.designer.all.executable.win32.win32.x86_64.zip"/>
										<zip destfile="${project.build.directory}/extraArtifacts/org.eclipse.birt.report.designer.all.executable.win32.win32.x86_64.zip" basedir="${project.build.directory}/executables-to-sign/x86_64"/>
										<delete file="${project.build.directory}/extraArtifacts/org.eclipse.birt.report.designer.all.executable.win32.win32.aarch64.zip"/>
										<zip destfile="${project.build.directory}/extraArtifacts/org.eclipse.birt.report.designer.all.executable.win32.win32.aarch64.zip" basedir="${project.build.directory}/executables-to-sign/aarch64"/>
										<delete dir="${project.build.directory}/executables-to-sign"/>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<plugin>
						<groupId>org.eclipse.cbi.maven.plugins</groupId>
						<artifactId>eclipse-winsigner-plugin</artifactId>
						<version>${cbi-version}</version>
						<executions>
							<execution>
								<id>sign</id>
								<goals>
									<goal>sign</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<replace>true</replace>
									<signFiles>
										<signFile>${project.build.directory}/executables-to-sign/x86_64/birt.exe</signFile>
										<signFile>${project.build.directory}/executables-to-sign/x86_64/birtc.exe</signFile>
										<signFile>${project.build.directory}/executables-to-sign/aarch64/birt.exe</signFile>
										<signFile>${project.build.directory}/executables-to-sign/aarch64/birtc.exe</signFile>
									</signFiles>
								</configuration>
							</execution>
						</executions>
					</plugin>

				</plugins>
			</build>
		</profile>
	</profiles>

	<build>


		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-maven-plugin</artifactId>
					<version>${tycho.version}</version>
					<extensions>true</extensions>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>

			<!-- Publish before signing the customized Windows launchers, so the p2
			     repository and product archives consume the signed executables.
			     Override the default executions outside the signing profile so Maven
			     applies these lifecycle bindings. -->
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-publisher-plugin</artifactId>
				<version>${tycho.version}</version>
				<executions>
					<execution>
						<id>default-publish-osgi-ee</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>publish-osgi-ee</goal>
						</goals>
					</execution>
					<execution>
						<id>default-publish-products</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>publish-products</goal>
						</goals>
					</execution>
					<execution>
						<id>default-publish-categories</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>publish-categories</goal>
						</goals>
					</execution>
					<execution>
						<id>default-attach-artifacts</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>attach-artifacts</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<version>${tycho.version}</version>
				<executions>
					<execution>
						<id>create-product-distributions</id>
						<goals>
							<goal>materialize-products</goal>
							<goal>archive-products</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<storeCreationTime>false</storeCreationTime>
					<products>
						<product>
							<id>org.eclipse.birt.report.designer.all</id>
							<archiveFileName>birt-report-designer-all-in-one-${birt.version}-${maven.build.timestamp}</archiveFileName>
							<rootFolder>eclipse</rootFolder>
						</product>
					</products>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<extensions>true</extensions>
			</plugin>
		</plugins>


	</build>

</project>